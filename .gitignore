# ============================================================================
# Python Language Files
# ============================================================================

# Byte-compiled / optimized / DLL files
# These are created by Python when modules are imported for faster loading
__pycache__/
*.py[cod]
*$py.class

# C extensions
# Compiled C extensions that may be built from Python packages
*.so

# Distribution / packaging
# Build artifacts from setuptools, wheel, and other packaging tools
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
# Usually these files are written by a python script from a template
# before PyInstaller builds the exe, so as to inject date/other infos into it
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
# Generated by pytest, coverage, tox, and other testing frameworks
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Translations
# Files generated by internationalization tools
*.mo
*.pot

# Django stuff (if using Django)
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff (if using Flask)
instance/
.webassets-cache

# Scrapy stuff (if using Scrapy)
.scrapy

# Sphinx documentation
# Generated documentation files
docs/_build/

# PyBuilder
# Artifacts from PyBuilder builds
.pybuilder/
target/

# IPython / Jupyter Notebook
# Checkpoint files and configs created by Jupyter
.ipynb_checkpoints
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# pyenv
# Python version file for pyenv version management
.python-version

# pipenv
# Pipenv lock and virtualenv files
Pipfile.lock

# poetry
# Poetry lock file and config
poetry.lock

# pdm
# PDM lock file and config
.pdm.toml
pdm.lock

# PEP 582
# Used by PDM for local package management
__pypackages__/

# Celery stuff (if using Celery)
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
# Type checking cache
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# ============================================================================
# UV Package Manager (modern Python package installer and resolver)
# ============================================================================

# UV virtual environments
.venv/
uv.lock

# ============================================================================
# Pip Package Manager
# ============================================================================

# Pip virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv-deploy/
venv-reports/

# Requirements files that may be auto-generated
# Keep requirements.txt in version control, but ignore machine-specific ones
requirements-dev.txt.lock
requirements.lock

# ============================================================================
# Conda Package Manager
# ============================================================================

# Conda environments
# These are typically created in project root or conda envs directory
.conda/
conda-env/
*.conda
*.tar.bz2

# Conda environment export files (if auto-generated)
# Keep your main environment.yml in version control
environment.*.yml
!environment.yml
!environment.yaml

# ============================================================================
# JetBrains IDEs (PyCharm, IntelliJ IDEA, WebStorm, etc.)
# ============================================================================

# User-specific stuff
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries
.idea/**/shelf

# AWS User-specific
.idea/**/aws.xml

# Generated files
.idea/**/contentModel.xml

# Sensitive or high-churn files
.idea/**/dataSources/
.idea/**/dataSources.ids
.idea/**/dataSources.local.xml
.idea/**/sqlDataSources.xml
.idea/**/dynamic.xml
.idea/**/uiDesigner.xml
.idea/**/dbnavigator.xml

# Gradle
.idea/**/gradle.xml
.idea/**/libraries

# Gradle and Maven with auto-import
.idea/artifacts
.idea/compiler.xml
.idea/jarRepositories.xml
.idea/modules.xml
.idea/*.iml
.idea/modules
*.iml
*.ipr

# CMake
cmake-build-*/

# Mongo Explorer plugin
.idea/**/mongoSettings.xml

# File-based project format
*.iws

# IntelliJ
out/

# mpeltonen/sbt-idea plugin
.idea_modules/

# JIRA plugin
atlassian-ide-plugin.xml

# Cursive Clojure plugin
.idea/replstate.xml

# SonarLint plugin
.idea/sonarlint/

# Crashlytics plugin (for Android Studio and IntelliJ)
com_crashlytics_export_strings.xml
crashlytics.properties
crashlytics-build.properties
fabric.properties

# Editor-based Rest Client
.idea/httpRequests

# Android studio 3.1+ serialized cache file
.idea/caches/build_file_checksums.ser

# ============================================================================
# Visual Studio Code
# ============================================================================

# VSCode settings and workspace files
# Consider keeping .vscode/ with shared settings in version control
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix

# ============================================================================
# Machine Learning Specific Files
# ============================================================================

# Data directories
# Raw and processed data should generally not be in version control
data/raw/**
data/processed/**
data/interim/**
data/external/**
data/*.csv
data/*.parquet
data/*.pkl
data/*.h5
data/*.hdf5
data/*.json
data/*.jsonl
data/*.xml
data/*.xlsx
data/*.xls

# Allow .gitkeep files to keep directory structure
!data/**/.gitkeep
!data/.gitkeep

# Model artifacts
# Trained models can be large and should typically be stored in MLflow, S3, etc.
models/*.pkl
models/*.h5
models/*.hdf5
models/*.pt
models/*.pth
models/*.ckpt
models/*.pb
models/*.onnx
models/*.joblib
models/*.model
models/*.bin
*.pkl
*.h5
*.hdf5
*.pt
*.pth
*.ckpt
*.safetensors

# Model checkpoints and training artifacts
checkpoints/
saved_models/
artifacts/
mlruns/

# Experiment tracking
# MLflow, Weights & Biases, and other tracking tools
mlruns/
mlartifacts/
.mlflow/
wandb/
.wandb/
runs/
lightning_logs/
tensorboard/
.tensorboard/

# Large datasets and embeddings
*.npy
*.npz
*.tfrecord
*.tfrecords
embeddings/
vectors/

# Feature stores
features/
feature_store/

# Logs and metrics
# Training logs, metric files, and profiling data
logs/**
*.log
*.log.*
events.out.tfevents.*
profile/
profiling/

# Visualization outputs
# Generated plots and figures (consider keeping final versions)
figures/tmp/
figures/draft/
plots/
*.png
*.jpg
*.jpeg
*.gif
*.svg
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.svg

# Results and reports
# Auto-generated results (keep curated versions in version control)
results/tmp/
results/experiments/
outputs/
reports/tmp/

# Notebooks outputs
# Keep notebooks, but optionally strip outputs before committing
# Uncomment below to ignore all notebooks (not recommended)
# *.ipynb

# Notebooks with outputs (if using nbstripout or similar)
*-checkpoint.ipynb

# AutoML outputs
# H2O, AutoGluon, TPOT, auto-sklearn artifacts
h2o-genmodel.jar
AutoML_*/
.autogluon/
tpot_*/

# Label Studio and annotation tools
label-studio/
labelbox/
annotations/raw/

# ============================================================================
# Environment and Secrets
# ============================================================================

# Environment files containing secrets and configurations
# NEVER commit these files as they may contain API keys, passwords, etc.
.env
.env.*
.envrc
!.env.example
!.env.template
*.env
.secrets
secrets.yaml
secrets.yml
credentials.json
service-account.json
*.pem
*.key

# Configuration files with sensitive data
config/local.py
config/secrets.py
config.local.yml
config.local.yaml

# ============================================================================
# Docker
# ============================================================================

# Docker volumes and build cache
.docker/
docker-compose.override.yml
*.dockerignore

